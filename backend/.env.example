PORT=5000
NODE_ENV=development

# MongoDB Connection String (use MongoDB Atlas in production)
# NEVER commit real credentials. Set this in Vercel Environment Variables.
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/aura-clinic

# Allowed Frontend Origin for CORS (your production domain)
# Example: https://your-project.vercel.app
CLIENT_URL=http://localhost:5173
